# Optional staff sign-in. Leave unset on GitHub Pages: the prototype then
# shows no sign-in button. For the local Podman stack in
# ../care-appointment-service/compose.yaml:
VITE_OIDC_AUTHORITY=http://localhost:8280/realms/care-appointment
VITE_OIDC_CLIENT_ID=care-appointment-success-ui
# Base URL of the Loco API (care-appointment-service). Needs sign-in above.
VITE_API_URL=http://127.0.0.1:5150/
